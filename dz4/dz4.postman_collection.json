{
  "info": {
    "name": "dz4-otus-api",
    "description": "Проверка API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework"
    }
  ],
  "item": [
    {
      "name": "GET /users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('status OK', function () {",
              "  pm.expect(pm.response.json().status).to.eql('OK');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /otusapp/roma/health (rewrite)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('rewrite на /health', function () {",
              "  pm.expect(pm.response.json().status).to.eql('OK');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/otusapp/roma/health"
      }
    },
    {
      "name": "GET /otusapp/aeugene/health (rewrite, другое имя)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('произвольное имя студента', function () {",
              "  pm.expect(pm.response.json().status).to.eql('OK');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/otusapp/aeugene/health"
      }
    }
  ]
}
