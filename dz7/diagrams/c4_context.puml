@startuml
title SmartHome System Context Diagram

top to bottom direction

!include https://raw.githubusercontent.com/butenromayandex/C4/main/C4_Context.puml

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!include FONTAWESOME/users.puml
!include DEVICONS/go.puml

Person(user, "Пользователи", "Пользователи системы", $sprite="users")

System(api_gw, "API Gateway", "Единая точка входа: TLS, маршрутизация")
System(bff, "BFF", "BFF для frontend: сессии, агрегация бэкендов", $sprite="go")
System(keycloak, "Keycloak", "OIDC IdP: аутентификация, выпуск токенов")

Rel(user, api_gw, "Запрос ресурса (HTTPS)")
Rel(api_gw, bff, "Маршрутизация по правилам")
Rel(bff, keycloak, "Авторизация (OIDC Authorization Code + PKCE)")
@enduml